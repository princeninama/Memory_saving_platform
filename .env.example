# GEMINI_API_KEY: Optional (only used if AI Studio runtime injects it).
GEMINI_API_KEY=""

# APP_URL: Public URL where the app is hosted.
APP_URL="http://localhost:3000"

# SITE_PASSWORD: Required for production! Passphrase used to unlock the private universe.
# Never expose this in client-side code or commit real secrets to git.
SITE_PASSWORD="goldenhour"

# PASSPHRASE_HINT: Optional gentle hint displayed on the private entry gate.
PASSPHRASE_HINT="The light when waves meet warm sand"

# SESSION_SECRET: Long random string used to sign HttpOnly session cookies.
SESSION_SECRET="change-this-to-a-long-random-secret-in-production"
